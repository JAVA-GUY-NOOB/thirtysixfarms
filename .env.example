# FarmCity Backend Environment Example
# Copy this file to .env and replace placeholders with real values.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=dev

# Database
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/farmcity
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# M-Pesa
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=http://localhost:8080/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Local admin bootstrap (optional)
APP_BOOTSTRAP_ADMIN=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@farmcity.local
APP_ADMIN_PASSWORD=admin123
