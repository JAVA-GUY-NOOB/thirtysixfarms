# FarmCity Backend Environment Template
# Copy this file to .env and replace placeholders before deployment.
# Keep real secrets in your host platform secret manager, not in git.

SPRING_PROFILES_ACTIVE=prod

# Database (Supabase/Postgres)
SUPABASE_DB_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
SUPABASE_DB_USER=<DB_USER>
SUPABASE_DB_PASSWORD=<DB_PASSWORD>

# JWT
JWT_SECRET_KEY=<a-long-secure-random-string>
JWT_EXPIRATION=86400000

# Stripe
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=<mpesa_consumer_key>
MPESA_CONSUMER_SECRET=<mpesa_consumer_secret>
MPESA_SHORTCODE=<shortcode>
MPESA_PASSKEY=<passkey>
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/mpesa/callback
MPESA_ENVIRONMENT=production
MPESA_BASE_URL=https://api.safaricom.co.ke

# Google Maps
GOOGLE_MAPS_API_KEY=<google_maps_api_key>

# Local admin bootstrap (for dev/local testing only)
APP_BOOTSTRAP_ADMIN=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@farmcity.local
APP_ADMIN_PASSWORD=admin123

# Other
# If using SMTP/email services, add SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD as needed
